// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ALMOXARIFE
  GESTOR
}

enum ItemType {
  CONSUMABLE
  ASSET
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum MovementType {
  DELIVERY    // Entrega ao colaborador
  RETURN      // Devolução pelo colaborador
  LOSS        // Perda registrada
  REPLACEMENT // Substituição (devolve e entrega novo)
  WRITEOFF    // Baixa do sistema
}

enum AuditAction {
  LOGIN
  CREATE
  UPDATE
  DELETE
  DELIVERY
  RETURN
  LOSS
  WRITEOFF
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ALMOXARIFE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  audits    Audit[]

  @@map("users")
}

model Employee {
  id           String         @id @default(cuid())
  name         String
  registration String         @unique
  jobTitle     String
  sector       String
  unit         String
  status       EmployeeStatus @default(ACTIVE)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  movements StockMovement[]
  // Assets currently assigned to this employee
  assets    Item[]          @relation("CurrentHolder")

  @@map("employees")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@map("categories")
}

model Item {
  id              String     @id @default(cuid())
  name            String
  description     String?
  type            ItemType
  categoryId      String
  // Consumable fields
  quantity        Int        @default(0)
  minStock        Int        @default(0)
  lotNumber       String?
  expiresAt       DateTime?
  unit            String     @default("un")
  // Asset fields
  patrimonyCode   String?    @unique
  serialNumber    String?
  currentHolderId String?
  status          ItemStatus @default(ACTIVE)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id])
  currentHolder Employee?       @relation("CurrentHolder", fields: [currentHolderId], references: [id])
  movements     StockMovement[]

  @@map("items")
}

model StockMovement {
  id          String       @id @default(cuid())
  type        MovementType
  itemId      String
  employeeId  String?
  userId      String
  quantity    Int          @default(1)
  notes       String?
  // Snapshot fields (preserved even if item/employee changes)
  itemName    String
  employeeName String?
  employeeRegistration String?
  createdAt   DateTime     @default(now())

  item     Item      @relation(fields: [itemId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}

model Audit {
  id        String      @id @default(cuid())
  userId    String
  action    AuditAction
  entity    String      // e.g. "employee", "item", "movement"
  entityId  String?
  details   Json?       // snapshot or description
  ip        String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audits")
}
